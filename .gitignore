# cargo-fuzz build output and libFuzzer-mined corpus entries (hex-named);
# curated named seeds under crates/*/fuzz/corpus/ stay tracked.
crates/*/fuzz/target/
crates/*/fuzz/corpus/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f]*
scripts/__pycache__/
